{
  "name": "raspberry-pi-camera-project",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @visit-monitor/web dev",
    "build:web": "node tools/write_web_build_id.mjs && pnpm --filter @visit-monitor/web build",
